# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Model access -------------------------------------------------------
# Hugging Face token for downloading gated models (e.g. DeepSeek-R1-Distill).
# https://huggingface.co/settings/tokens
HF_TOKEN=

# LLM-as-judge for faithfulness/verbosity scoring. The grader uses OpenRouter.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Some scripts also use the OpenAI API directly for judging.
OPENAI_API_KEY=

# --- Paths (optional; sensible defaults if unset) -----------------------
# Where Hugging Face caches downloaded models/datasets. Defaults to the
# standard HF cache (~/.cache/huggingface) if unset.
# HF_HOME=

# --- Notifications (optional) -------------------------------------------
# ntfy.sh topic for run-completion pings from the long-running shell scripts.
# Leave unset to disable.
# NTFY_TOPIC=
