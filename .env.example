# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.

# --- Model access -------------------------------------------------------
# Hugging Face token for downloading gated models (e.g. the Gemma family).
# https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Judge --------------------------------------------------------------
# OpenAI API key for the scoring judge (batch_scoring.py, gpt-5-nano).
OPENAI_API_KEY=

# --- Paths (optional; sensible defaults if unset) -----------------------
# Where Hugging Face caches downloaded models/datasets. Defaults to the
# standard HF cache (~/.cache/huggingface) if unset.
# HF_HOME=

# --- Notifications (optional) -------------------------------------------
# ntfy.sh topic for run-completion pings from the long-running shell scripts.
# Leave unset to disable.
# NTFY_TOPIC=
